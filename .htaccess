# ====================
# SMTP EMAIL CONFIGURATION
# ====================
# These environment variables are used by config/email.php
# IMPORTANT: Set these in your production environment
# SetEnv SMTP_HOST your-smtp-host.com
# SetEnv SMTP_PORT 465
# SetEnv SMTP_USER your-email@yourdomain.com
# SetEnv SMTP_PASS your-secure-password

# ====================
# COMPRESSION
# ====================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ====================
# BROWSER CACHING
# ====================

<IfModule mod_expires.c>
    ExpiresActive on
    
    # CSS - 1 hour. The guest site loads css/main.css, which pulls ~30 partials
    # via @import; a query string on main.css is NOT inherited by those imports,
    # so no cache-busting stamp can reach them. A short TTL is what makes a CSS
    # deploy (e.g. a header or loader restyle) actually reach returning visitors.
    ExpiresByType text/css "access plus 1 hour"

    # JavaScript - 1 year (footer.php stamps js/*.js with ?v=filemtime)
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # HTML - 1 hour (dynamic content)
    ExpiresByType text/html "access plus 1 hour"
    
    # Images - 1 year
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fonts - 1 year
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # Documents - 1 month
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/json "access plus 1 month"
</IfModule>

# ====================
# FILE ACCESS DENIAL
# ====================
# This file previously had no Files / FilesMatch / Require rule of any kind, so
# nothing stopped a config or dotfile being fetched over HTTP. A .env at the web
# root would have been served as PLAINTEXT, credentials included.
#
# Apache 2.4 uses "Require all denied"; the mod_authz_core fallback keeps this
# working on 2.2. Both are present so the rule cannot silently do nothing.

# Dotfiles (.env, .env.local, .git*, .user.ini, .htpasswd …)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Credentials, dependency manifests, dumps, logs and backups.
# NOTE: config/*.php is intentionally NOT denied here — the app serves pages that
# include those files; PHP executes them and they emit nothing. Denying by
# extension would break nothing but adds no protection either.
<FilesMatch "(?i)\.(env|ini|log|sql|sql\.gz|sqlite|db|bak|backup|old|orig|save|swp|swo|dist|lock|yml|yaml|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Re-allow the few JSON files the site legitimately serves.
<FilesMatch "(?i)^(manifest|site|browserconfig)\.json$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Version-control, dependency and private directories.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.git|\.github|node_modules|vendor/bin)(/|$) - [F,L]
    RewriteRule ^(backups|logs|cache)(/|$) - [F,L]
</IfModule>

# ====================
# SECURITY HEADERS
# ====================

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ====================
# PERFORMANCE
# ====================

# Disable ETags for better caching
FileETag None

# Prevent directory browsing
Options -Indexes

# Force HTTPS
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Dynamic Sitemap
    RewriteRule ^sitemap\.xml$ generate-sitemap.php [L]
    
    # Dynamic Robots.txt
    RewriteRule ^robots\.txt$ robots.php [L]
    
    # Favicon - redirect legacy .ico/.png requests to SVG
    RewriteRule ^favicon\.ico$ favicon.svg [L,T=image/svg+xml]
    RewriteRule ^favicon-32x32\.png$ favicon.svg [L,T=image/svg+xml]
    RewriteRule ^favicon-16x16\.png$ favicon.svg [L,T=image/svg+xml]
    RewriteRule ^apple-touch-icon\.png$ /images/logo/logo.jpg [L]
</IfModule>
